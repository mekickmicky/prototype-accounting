# Root env — shared across api + web. Copy to .env and fill in.
# Each app also has its own .env.example with the subset it needs.

# === Database (consumed by apps/api) ===
DATABASE_URL="postgresql://wind:wind_dev@localhost:5433/wind_accounting?schema=public"

# === Auth (consumed by apps/api) ===
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-locally-then-rotate-in-production"

# === Webhook signing secrets (consumed by apps/api) ===
# Used to verify HMAC signatures on incoming webhook payloads from sister systems.
WEBHOOK_SECRET_WIND_CLINIC="change-me-shared-with-wind-clinic"
WEBHOOK_SECRET_WIND_STOCK="change-me-shared-with-wind-stock"

# === Bank provider (consumed by apps/api) ===
# 'mock' for prototype; 'kbank' / 'scb' once real integration ships.
BANK_PROVIDER="mock"

# === API URL (consumed by apps/web at build time and runtime) ===
NEXT_PUBLIC_API_URL="http://localhost:3001"

# === Optional: timezone hint for tooling ===
TZ="Asia/Bangkok"

# === Telegram notifications (consumed by scripts/notify.ts) ===
# Used by orchestrator + workers to ping a Telegram bot when tasks
# start / finish / block. Leave empty to disable (notify.ts no-ops).
# Get token from @BotFather; chat_id from sending a message to your
# bot then visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# === Orchestrator runtime overrides (consumed by scripts/orchestrate.ts) ===
# Temporarily route tasks planned as DeepSeek through Sonnet (or Opus)
# without editing task specs. Leave empty to use planned model.
# Valid values: Sonnet, Opus, "" (no override)
DEEPSEEK_FALLBACK=""

# === Healthchecks.io dead-man's switch (consumed by scripts/orchestrate.ts auto) ===
# Full URL of your check at https://healthchecks.io. Auto loop pings this URL
# every cycle. If pings stop, Healthchecks alerts you (email/Telegram/etc.).
# Leave empty to disable. Set up:
#   1. Sign up at https://healthchecks.io (free)
#   2. Create a check; set period to ~60s, grace to ~5min
#   3. Copy the ping URL (looks like https://hc-ping.com/<uuid>)
HEALTHCHECK_PING_URL=""

# === Langfuse observability (consumed by scripts/ and orchestrator) ===
# Self-hosted Langfuse at http://localhost:3030 (see docs/setup/langfuse-running.md).
# Start with: docker compose up -d langfuse-db langfuse-server
# Then create a project + API keys in the UI and copy them here.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="http://localhost:3030"